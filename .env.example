# =====================================================================
# Monitoreo de Tanque - variables de entorno
# Copie este archivo a .env.local y ajuste los valores.
# NUNCA escriba secretos directamente en el codigo fuente.
# =====================================================================

# --- Base de datos ---------------------------------------------------
# Cadena de conexion a PostgreSQL.
# Si se deja vacia, el sistema arranca con un almacen EN MEMORIA
# (util para una demo rapida; los datos se pierden al reiniciar).
DATABASE_URL=postgresql://tanque:tanque@localhost:5434/tanque

# --- API -------------------------------------------------------------
# URL base publica. La usa el simulador por linea de comandos y sirve de
# referencia para configurar el firmware del ESP8266.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Dispositivo -----------------------------------------------------
# Identificador logico del unico ESP8266 del sistema. Debe coincidir
# exactamente con el "deviceId" que envia la placa.
DEVICE_ID=ESP8266-TANQUE-001
DEVICE_NAME=ESP8266 Tanque Principal

# Segundos sin recibir lecturas tras los cuales el dispositivo se marca
# OFFLINE y se abre la alerta DEVICE_OFFLINE.
DEVICE_TIMEOUT_SECONDS=60

# --- Tanque ----------------------------------------------------------
TANK_NAME=Tanque Principal

# Minutos en NIVEL BAJO tras los cuales la alerta LOW_LEVEL escala
# de WARNING a CRITICAL.
LOW_LEVEL_CRITICAL_MINUTES=15

# --- Simulador (desarrollo) ------------------------------------------
# Habilita /api/mock y el panel de simulacion del dashboard.
# Pongalo en false cuando el ESP8266 real este conectado.
MOCK_ESP8266_ENABLED=true
MOCK_ESP8266_INTERVAL_MS=5000

# --- Polaridad de los sensores ---------------------------------------
# Describe como esta cableado cada sensor:
#   false -> Normally Open   : el sensor esta ACTIVO cuando el pin lee HIGH
#   true  -> Normally Closed : el sensor esta ACTIVO cuando el pin lee LOW
# El backend siempre trabaja con el significado LOGICO; esta configuracion
# documenta el cableado y la aplica el firmware al construir el JSON.
SENSOR_LOW_ACTIVE_LOW=false
SENSOR_HIGH_ACTIVE_LOW=false
